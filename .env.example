# Copy values into a private environment file or service manager. Never commit real secrets.
SCANNER_ACCESS_PASSWORD=replace-with-a-long-random-password
SCANNER_BIND=127.0.0.1
SCANNER_ALLOWED_ORIGINS=https://scanner.example.local
ASSISTANT_ENABLED=false
ASSISTANT_IMAGE_ENABLED=false
XAI_API_KEY=replace-with-xai-api-key
XAI_MODEL=grok-4.7
XAI_API_ENDPOINT=https://api.x.ai/v1/responses
ASSISTANT_CONNECT_TIMEOUT=5
ASSISTANT_READ_TIMEOUT=25
ASSISTANT_TOTAL_TIMEOUT=35
ASSISTANT_OUTPUT_TOKENS=300
ASSISTANT_CONCURRENCY=2
ASSISTANT_PER_MINUTE=6
ASSISTANT_DAILY_REQUESTS=50
